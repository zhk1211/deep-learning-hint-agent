// Solution
#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;
    multiset<int> a, b;
    for (int i = 0; i < n; ++i) {
        int x;
        cin >> x;
        while (x % 2 == 0) {
            x /= 2;
        }
        a.insert(x);
    }
    for (int i = 0; i < n; ++i) {
        int x;
        cin >> x;
        b.insert(x);
    }
    while (!b.empty()) {
        int x = *b.rbegin();
        if (a.find(x) == a.end()) {
            if (x == 1) break;
            b.erase(b.find(x));
            b.insert(x / 2);
        } else {
            b.erase(b.find(x));
            a.erase(a.find(x));
        }
    }
    cout << (b.empty() ? "YES" : "NO") << '\n';
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
