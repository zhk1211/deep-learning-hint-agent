```cpp
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    scanf("%d", &t);
    while (t--) {
        int n;
        scanf("%d", &n);
        vector<int> h(n);
        for (int i = 0; i < n; ++i) {
            scanf("%d", &h[i]);
        }
        int mx = *max_element(h.begin(), h.end());
        long long ans = 1e18;
        for (int need : {mx, mx + 1}) {
            long long cnt1 = 0, cnt2 = 0;
            for (int i = 0; i < n; ++i) {
                cnt2 += (need - h[i]) / 2;
                cnt1 += (need - h[i]) % 2;
            }
            long long dif = max(0LL, cnt2 - cnt1 - 1) / 3;
            cnt1 += dif * 2;
            cnt2 -= dif;
            ans = min(ans, max(cnt1 * 2 - 1, cnt2 * 2));
            if (cnt2 > 0) {
                cnt1 += 2;
                --cnt2;
                ans = min(ans, max(cnt1 * 2 - 1, cnt2 * 2));
            }
        }
        printf("%lld\n", ans);
    }
    return 0;
}
```