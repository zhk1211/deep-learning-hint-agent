// Solution
#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n, a, b;
    cin >> n >> a >> b;
    --a; --b;
    
    vector<vector<pair<int, int>>> adj(n);
    for (int i = 0; i < n - 1; ++i) {
        int u, v, w;
        cin >> u >> v >> w;
        --u; --v;
        adj[u].push_back({v, w});
        adj[v].push_back({u, w});
    }
    
    set<int> s;
    
    function<void(int, int, int)> dfs1 = [&](int u, int par, int x) {
        if (u == b) return;
        s.insert(x);
        for (auto [v, w] : adj[u]) {
            if (v == par) continue;
            dfs1(v, u, x ^ w);
        }
    };
    
    dfs1(a, -1, 0);
    
    function<bool(int, int, int)> dfs2 = [&](int u, int par, int x) {
        if (u != b && s.count(x)) return true;
        for (auto [v, w] : adj[u]) {
            if (v == par) continue;
            if (dfs2(v, u, x ^ w)) return true;
        }
        return false;
    };
    
    if (dfs2(b, -1, 0)) {
        cout << "YES\n";
    } else {
        cout << "NO\n";
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
