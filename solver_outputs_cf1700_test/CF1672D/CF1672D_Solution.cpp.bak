// Solution
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> a(n), b(n);
        for (int i = 0; i < n; ++i) cin >> a[i];
        for (int i = 0; i < n; ++i) cin >> b[i];

        vector<int> cnt(n + 1, 0);
        int i = 0, j = 0;
        bool ok = true;
        while (j < n) {
            if (i < n && a[i] == b[j]) {
                ++i;
                ++j;
            } else if (j > 0 && b[j] == b[j - 1] && cnt[b[j]] > 0) {
                --cnt[b[j]];
                ++j;
            } else if (i < n) {
                ++cnt[a[i]];
                ++i;
            } else {
                ok = false;
                break;
            }
        }
        cout << (ok ? "YES" : "NO") << '\n';
    }
    return 0;
}
