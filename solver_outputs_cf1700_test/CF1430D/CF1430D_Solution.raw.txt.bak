```cpp
#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    scanf("%d", &t);
    while (t--) {
        int n;
        scanf("%d", &n);
        char buf[200043];
        scanf("%s", buf);
        string s = buf;
        queue<int> q;
        int cur = 0;
        for (int i = 0; i < n; i++) {
            if (i > 0 && s[i] != s[i - 1])
                cur++;
            if (i > 0 && s[i] == s[i - 1])
                q.push(cur);
        }
        int deleted = 0;
        int score = 0;
        for (int i = 0; i < n; i++) {
            if (q.empty())
                break;
            q.pop();
            deleted++;
            score++;
            while (!q.empty() && q.front() == i) {
                q.pop();
                deleted++;
            }
            deleted++;
        }
        score += (n - deleted + 1) / 2;
        printf("%d\n", score);
    }
    return 0;
}
```