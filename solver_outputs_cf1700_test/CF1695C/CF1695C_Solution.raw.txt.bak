```cpp
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n, m;
        cin >> n >> m;
        vector<vector<int>> a(n, vector<int>(m));
        for (int i = 0; i < n; ++i)
            for (int j = 0; j < m; ++j)
                cin >> a[i][j];

        vector<vector<int>> mn(n, vector<int>(m));
        vector<vector<int>> mx(n, vector<int>(m));

        mn[0][0] = mx[0][0] = a[0][0];
        for (int i = 1; i < n; ++i) {
            mn[i][0] = mx[i][0] = mn[i - 1][0] + a[i][0];
        }
        for (int j = 1; j < m; ++j) {
            mn[0][j] = mx[0][j] = mn[0][j - 1] + a[0][j];
        }

        for (int i = 1; i < n; ++i) {
            for (int j = 1; j < m; ++j) {
                mx[i][j] = max(mx[i - 1][j], mx[i][j - 1]) + a[i][j];
                mn[i][j] = min(mn[i - 1][j], mn[i][j - 1]) + a[i][j];
            }
        }

        if (mx[n - 1][m - 1] % 2 != 0 || mn[n - 1][m - 1] > 0 || mx[n - 1][m - 1] < 0)
            cout << "NO\n";
        else
            cout << "YES\n";
    }
    return 0;
}
