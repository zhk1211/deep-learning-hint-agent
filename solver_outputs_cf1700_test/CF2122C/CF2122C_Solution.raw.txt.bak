```cpp
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<long long> x(n), y(n);
        vector<int> idx(n);
        for (int i = 0; i < n; ++i) {
            cin >> x[i] >> y[i];
            idx[i] = i;
        }

        // Sort indices by x
        sort(idx.begin(), idx.end(), [&](int i, int j) {
            return x[i] < x[j];
        });

        vector<bool> inXl(n, false);
        for (int i = 0; i < n / 2; ++i) {
            inXl[idx[i]] = true;
        }

        // Sort indices by y
        sort(idx.begin(), idx.end(), [&](int i, int j) {
            return y[i] < y[j];
        });

        vector<bool> inYl(n, false);
        for (int i = 0; i < n / 2; ++i) {
            inYl[idx[i]] = true;
        }

        // Four groups
        vector<int> A, B, C, D; // A: Xl & Yl, B: Xr & Yr, C: Xl & Yr, D: Xr & Yl
        for (int i = 0; i < n; ++i) {
            if (inXl[i] && inYl[i]) A.push_back(i);
            else if (!inXl[i] && !inYl[i]) B.push_back(i);
            else if (inXl[i] && !inYl[i]) C.push_back(i);
            else D.push_back(i);
        }

        // Pair A with B, C with D
        for (size_t i = 0; i < A.size(); ++i) {
            cout << A[i] + 1 << ' ' << B[i] + 1 << '\n';
        }
        for (size_t i = 0; i < C.size(); ++i) {
            cout << C[i] + 1 << ' ' << D[i] + 1 << '\n';
        }
    }
    return 0;
}
```