```cpp
#include <bits/stdc++.h>
using namespace std;

#define int long long

signed main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> a(2 * n);
        for (int i = 0; i < 2 * n; ++i) {
            cin >> a[i];
        }
        sort(a.begin(), a.end(), greater<int>());
        
        vector<int> b(n);
        bool ok = true;
        for (int i = 0; i < n; ++i) {
            if (a[2 * i] != a[2 * i + 1]) {
                ok = false;
                break;
            }
            b[i] = a[2 * i];
        }
        if (!ok) {
            cout << "NO\n";
            continue;
        }
        
        vector<int> d(n);
        for (int i = 1; i < n; ++i) {
            if (b[i - 1] == b[i] || (b[i - 1] - b[i]) % (2 * (n - i)) != 0) {
                ok = false;
                break;
            }
            d[i] = (b[i - 1] - b[i]) / (2 * (n - i));
        }
        if (!ok) {
            cout << "NO\n";
            continue;
        }
        
        int sum = 0;
        for (int i = 1; i < n; ++i) {
            sum += 2 * i * d[i];
        }
        int rem = b[n - 1] - sum;
        if (rem <= 0 || rem % (2 * n) != 0) {
            cout << "NO\n";
        } else {
            cout << "YES\n";
        }
    }
    return 0;
}
