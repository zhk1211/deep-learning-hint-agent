```cpp
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> a(n), b(n);
        vector<int> ca(n + 1, 0), cb(n + 1, 0);
        
        for (int i = 0; i < n; ++i) {
            cin >> a[i] >> b[i];
            ca[a[i]]++;
            cb[b[i]]++;
        }
        
        long long ans = n * 1LL * (n - 1) * (n - 2) / 6;
        for (int i = 0; i < n; ++i) {
            ans -= (ca[a[i]] - 1) * 1LL * (cb[b[i]] - 1);
        }
        
        cout << ans << '\n';
    }
    
    return 0;
}
```