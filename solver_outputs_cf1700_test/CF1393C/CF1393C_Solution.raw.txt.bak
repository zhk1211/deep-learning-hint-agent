```cpp
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;
    while (T--) {
        int n;
        cin >> n;
        vector<int> a(n);
        for (int i = 0; i < n; ++i) {
            cin >> a[i];
        }

        vector<int> cnt(n + 1, 0);
        for (int x : a) {
            cnt[x]++;
        }

        int max_freq = 0;
        int count_max = 0;
        for (int i = 1; i <= n; ++i) {
            if (cnt[i] > max_freq) {
                max_freq = cnt[i];
                count_max = 1;
            } else if (cnt[i] == max_freq) {
                count_max++;
            }
        }

        // The maximum possible minimum distance is:
        // (n - count_max) / (max_freq - 1) - 1
        // But we need to ensure it's non-negative.
        int ans = (n - count_max) / (max_freq - 1) - 1;
        cout << ans << '\n';
    }

    return 0;
}
```