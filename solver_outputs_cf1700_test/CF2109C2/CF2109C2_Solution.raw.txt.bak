```cpp
#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    
    while (t--) {
        long long n;
        cin >> n;
        
        // Step 1: mul 9
        cout << "mul 9" << endl;
        int resp;
        cin >> resp;
        if (resp == -1) return 0;
        
        // Step 2: digit
        cout << "digit" << endl;
        cin >> resp;
        if (resp == -1) return 0;
        
        // Step 3: digit
        cout << "digit" << endl;
        cin >> resp;
        if (resp == -1) return 0;
        
        // Step 4: add n-9
        long long add_val = n - 9;
        cout << "add " << add_val << endl;
        cin >> resp;
        if (resp == -1) return 0;
        
        // Answer
        cout << "!" << endl;
        cin >> resp;
        if (resp == -1) return 0;
    }
    
    return 0;
}
