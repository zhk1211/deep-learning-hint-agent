// Solution
#include <bits/stdc++.h>
using namespace std;

const int N = 1e6 + 10;
const int MOD = 998244353;

int dp[N];

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int n;
    cin >> n;
    
    // Count divisors for each number up to n
    for (int i = 1; i <= n; i++) {
        for (int j = i + i; j <= n; j += i) {
            dp[j]++;
        }
    }
    
    // dp[0] = 1, S = 1
    dp[0] = 1;
    int S = 1;
    
    for (int i = 1; i <= n; i++) {
        dp[i] = (dp[i] + S) % MOD;
        S = (S + dp[i]) % MOD;
    }
    
    cout << dp[n] << '\n';
    
    return 0;
}
