```cpp
#include <iostream>
#include <vector>
#include <map>
#include <queue>

using namespace std;

void solve() {
    int n;
    cin >> n;
    vector<int> a(n);
    map<int, priority_queue<int>> mp;
    
    for (int i = 0; i < n; i++) {
        cin >> a[i];
        mp[a[i] >> 2].push(-a[i]);
    }
    
    for (int i = 0; i < n; i++) {
        int key = a[i] >> 2;
        cout << -mp[key].top() << " ";
        mp[key].pop();
    }
    cout << "\n";
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    return 0;
}
```