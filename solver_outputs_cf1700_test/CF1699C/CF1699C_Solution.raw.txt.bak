```cpp
#include <bits/stdc++.h>
using namespace std;

const int MOD = 1e9 + 7;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<int> a(n);
        for (int i = 0; i < n; ++i) {
            cin >> a[i];
        }

        vector<int> pos(n);
        for (int i = 0; i < n; ++i) {
            pos[a[i]] = i;
        }

        long long ans = 1;
        int l = pos[0], r = pos[0];
        for (int k = 1; k < n; ++k) {
            int p = pos[k];
            if (p < l) {
                l = p;
            } else if (p > r) {
                r = p;
            } else {
                ans = ans * (r - l + 1 - k) % MOD;
            }
        }
        cout << ans << '\n';
    }
    return 0;
}
```