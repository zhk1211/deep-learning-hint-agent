```cpp
#include <bits/stdc++.h>
using namespace std;

const int N = 50000;
bool isPrime[N];
vector<int> primes;

void precalc() {
    fill(isPrime + 2, isPrime + N, true);
    for (int i = 2; i * i < N; i++) {
        if (isPrime[i]) {
            for (int j = i * i; j < N; j += i) {
                isPrime[j] = false;
            }
        }
    }
    for (int i = 2; i < N; i++) {
        if (isPrime[i]) {
            primes.push_back(i);
        }
    }
}

int calcPrime(int n) {
    int res = 0;
    for (int p : primes) {
        if (p * p > n) break;
        while (n % p == 0) {
            n /= p;
            res++;
        }
    }
    if (n > 1) res++;
    return res;
}

void solve() {
    int a, b, k;
    cin >> a >> b >> k;
    
    int max_moves = calcPrime(a) + calcPrime(b);
    
    int min_moves;
    if (a == b) {
        min_moves = 0;
    } else if (a % b == 0 || b % a == 0) {
        min_moves = 1;
    } else {
        min_moves = 2;
    }
    
    if (k == 1) {
        if (min_moves == 1 && k <= max_moves) {
            cout << "YES\n";
        } else {
            cout << "NO\n";
        }
    } else {
        if (min_moves <= k && k <= max_moves) {
            cout << "YES\n";
        } else {
            cout << "NO\n";
        }
    }
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    
    precalc();
    
    int t;
    cin >> t;
    while (t--) {
        solve();
    }
    
    return 0;
}
```