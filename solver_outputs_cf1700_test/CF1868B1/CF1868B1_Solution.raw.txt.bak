```cpp
#include <bits/stdc++.h>
using namespace std;
using ll = long long;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int t;
    cin >> t;
    while (t--) {
        int n;
        cin >> n;
        vector<ll> a(n);
        ll sum = 0;
        for (int i = 0; i < n; ++i) {
            cin >> a[i];
            sum += a[i];
        }
        if (sum % n != 0) {
            cout << "No\n";
            continue;
        }
        ll s = sum / n;
        vector<int> bit(31, 0);
        bool ok = true;
        for (int i = 0; i < n; ++i) {
            if (a[i] == s) continue;
            ll d = abs(a[i] - s);
            ll p = d & -d;
            ll e = d + p;
            if (__builtin_popcountll(e) == 1) {
                int x = __lg(e);
                int y = __lg(p);
                if (a[i] > s) {
                    bit[x]++;
                    bit[y]--;
                } else {
                    bit[x]--;
                    bit[y]++;
                }
            } else {
                ok = false;
                break;
            }
        }
        if (!ok) {
            cout << "No\n";
            continue;
        }
        for (int i = 0; i < 31; ++i) {
            if (bit[i] != 0) {
                ok = false;
                break;
            }
        }
        cout << (ok ? "Yes" : "No") << '\n';
    }
    return 0;
}
```